@using DanLoopServer.Models
@{ ViewData["Title"] = "Configure AI connections"; var catalog = ViewBag.Catalog as List<AiProviderCatalogItem> ?? []; var existing = ViewBag.Models as List<RemoteModel> ?? []; }
<div class="auth-wrap"><section class="auth-card wizard-card">
    <p class="eyebrow">FIRST RUN · STEP 2 OF 4</p>
    <h1>Connect AI.</h1>
    <p>Add one or several AI connections and mark what each model should do. If nothing is selected, the predefined model capabilities are used.</p>
    @if (existing.Any())
    {
        <div class="wizard-connections">
            @foreach (var connection in existing) { <span class="pill">@(connection.Name) · @string.Join(", ", AiCapabilities.Effective(connection))</span> }
        </div>
    }
    <div asp-validation-summary="All" class="error"></div>
    <form method="post" data-ai-connection-form>
        <label>Connection type<select name="providerId" data-ai-provider data-icon-select>@foreach (var provider in catalog) { <option value="@provider.Id" data-base-url="@provider.BaseUrl" data-docs="@provider.DocumentationUrl" data-key-url="@provider.ApiKeyUrl" data-pricing="@provider.PricingUrl">@provider.Name</option> }</select></label>
        <label>Display name<input name="name" value="@(Context.Request.HasFormContentType ? Context.Request.Form["name"] : "My AI")" required autofocus /></label>
        <label>Model<select data-ai-model-select data-icon-select required><option value="">Select a model</option></select><span class="model-discovery-actions"><button type="button" class="secondary compact-button" data-ai-load-models>Load live models</button><small data-ai-discovery-status aria-live="polite"></small></span></label><label data-ai-custom-model hidden>Other model ID<input data-ai-custom-model-input autocomplete="off" spellcheck="false" /></label><input type="hidden" name="modelId" data-ai-model-value />
        <label>Model URL<input name="baseUrl" value="@(Context.Request.HasFormContentType ? Context.Request.Form["baseUrl"] : catalog.FirstOrDefault()?.BaseUrl)" type="url" required /></label>
        <label data-ai-authentication>Authentication<select name="authenticationType" data-ai-authentication-select>@foreach (var type in AiAuthenticationTypes.All) { <option value="@type">@type</option> }</select></label>
        <label data-ai-key-header hidden>Header name<input name="apiKeyHeaderName" value="api-key" /></label>
        <label data-ai-api-key>API credential<input name="apiKey" type="password" autocomplete="off" /></label>
        <fieldset class="capability-picker"><legend>Active capabilities</legend>@foreach (var capability in AiCapabilities.All) { <label class="check" data-ai-capability="@capability"><input type="checkbox" name="capabilities" value="@capability" /> @capability</label> }</fieldset>
        <div class="provider-links" data-provider-links></div>
        <div class="wizard-actions"><button name="addAnother" value="true">Add another</button><button class="secondary" name="addAnother" value="false">Add and continue →</button></div>
    </form>
    <script type="application/json" id="ai-provider-catalog">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(catalog, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))</script>
    <a class="wizard-skip" asp-controller="GitHub" asp-action="Setup">Skip for now</a>
</section></div>
