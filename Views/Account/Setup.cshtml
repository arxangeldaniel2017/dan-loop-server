@{ ViewData["Title"] = "Create admin"; }
<div class="auth-wrap"><section class="auth-card"><p class="eyebrow">FIRST RUN</p><h1>Set up your control plane.</h1><p>Create the administrator account. This is only shown while no admin exists.</p><div asp-validation-summary="All" class="error"></div><form method="post"><label>Admin username<input name="username" minlength="3" maxlength="64" required autofocus /></label><label>Password<input name="password" type="password" minlength="10" required /></label><label>Confirm password<input name="confirmPassword" type="password" minlength="10" required /></label><button>Create administrator →</button></form><small>Passwords are stored with PBKDF2-SHA256 hashing.</small></section></div>
