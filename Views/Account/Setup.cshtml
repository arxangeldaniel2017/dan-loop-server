@{ ViewData["Title"] = "Create admin"; }
<div class="auth-wrap"><section class="auth-card"><p class="eyebrow">FIRST RUN · STEP 1 OF 4</p><h1>Set up your control plane.</h1><p>Create the administrator account. This is only shown while no admin exists.</p><div asp-validation-summary="All" class="error"></div><form method="post"><label>Admin username<input name="username" value="@(Context.Request.HasFormContentType ? Context.Request.Form["username"] : "admin")" minlength="3" maxlength="64" autocomplete="username" required autofocus /></label><label>Password<input name="password" type="password" minlength="10" autocomplete="new-password" required /></label><label>Confirm password<input name="confirmPassword" type="password" minlength="10" autocomplete="new-password" required /></label><button>Create administrator →</button></form><small>Passwords are stored with PBKDF2-SHA256 hashing.</small></section></div>
