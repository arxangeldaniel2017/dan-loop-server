@{ ViewData["Title"] = "Create project"; }
<div class="auth-wrap"><section class="auth-card wizard-card">
    <p class="eyebrow">FIRST RUN · STEP 2 OF 3</p>
    <h1>Create a project.</h1>
    <p>Start with the workspace that will hold your loops, jobs, files, and connection defaults.</p>
    <div asp-validation-summary="All" class="error"></div>
    <form method="post">
        <label>Name<input name="name" value="@(Context.Request.HasFormContentType ? Context.Request.Form["name"] : "My Project")" required maxlength="100" autofocus /></label>
        <label>Description<input name="description" value="@(Context.Request.HasFormContentType ? Context.Request.Form["description"] : "")" maxlength="500" /></label>
        <label>Project system prompt<textarea name="systemPrompt" rows="4" placeholder="Instructions applied to every job in this project">@(Context.Request.HasFormContentType ? Context.Request.Form["systemPrompt"] : "")</textarea></label>
        <button>Create project and continue →</button>
    </form>
</section></div>
