@{ ViewData["Title"] = "Sign in"; var requireTurnstile = ViewBag.RequireTurnstile as bool? == true; }
<div class="auth-wrap"><section class="auth-card"><p class="eyebrow">DAN LOOP</p><h1>Welcome back.</h1><p>Sign in to manage your loops and jobs.</p><div asp-validation-summary="All" class="error"></div><form method="post"><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/><label>Username<input name="username" maxlength="64" required autofocus autocomplete="username" /></label><label>Password<input name="password" type="password" maxlength="1024" required autocomplete="current-password" /></label>@if (requireTurnstile) { <div class="cf-turnstile" data-sitekey="@ViewBag.TurnstileSiteKey"></div> }<button>Sign in →</button></form></section></div>
@section Scripts { @if (requireTurnstile) { <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script> } }
