@model DashboardViewModel
@inject GitHubService GitHub
@{
    ViewData["Title"] = "Dashboard";
    bool CanManage(Guid projectId) => Model.IsAdmin || Model.State.Permissions.Any(x => x.UserId == Model.CurrentUserId && x.ProjectId == projectId && x.CanManage);
    bool CanRun(Guid projectId) => Model.IsAdmin || Model.State.Permissions.Any(x => x.UserId == Model.CurrentUserId && x.ProjectId == projectId && x.CanRun);
}

<section class="hero">
    <div><p class="eyebrow">ORCHESTRATION CONTROL PLANE</p><h1>Loops that keep moving.</h1><p>Manage prompts, recurring work, remote models and access from one local dashboard.</p></div>
    <div class="metrics"><div><strong>@Model.VisibleProjects.Count</strong><span>projects</span></div><div><strong>@Model.State.Loops.Count(x => x.IsEnabled)</strong><span>live loops</span></div></div>
</section>

@if (TempData["Message"] is string message) { <div class="notice" data-auto-dismiss-notice role="status"><span>@message</span><button type="button" class="notice-close" data-notice-close aria-label="Dismiss message">×</button><i class="notice-timer" aria-hidden="true"></i></div> }

<nav class="tabs">
    <button class="tab active" data-tab="projects">Projects</button><button class="tab" data-tab="steps">Steps</button><button class="tab" data-tab="jobs">Jobs</button><button class="tab" data-tab="files">Files</button><button class="tab" data-tab="chats">Messages</button>
    @if (Model.IsAdmin) { <button class="tab advanced-tab" data-tab="workspace">AI access <small>Advanced</small></button><button class="tab" data-tab="connections">Connections</button><button class="tab" data-tab="access">Users</button> }
</nav>

<section id="projects" class="panel tab-panel active" data-disclosure-scope>
    <div class="export-toolbar"><button type="button" class="secondary" data-disclosure-action="expand" data-disclosure-target=".project-disclosure">Expand all projects</button><button type="button" class="secondary" data-disclosure-action="collapse" data-disclosure-target=".project-disclosure">Collapse all projects</button><a class="button secondary" asp-controller="Export" asp-action="Projects">Export projects CSV</a><a class="button secondary" asp-controller="Export" asp-action="Loops">Export loops CSV</a></div>
    @if (Model.IsAdmin)
    {
        <details class="create-box"><summary>＋ New project</summary>
            <form asp-controller="Manage" asp-action="CreateProject" method="post" class="form-grid">
                <label>Name<input name="name" required maxlength="100" /></label>
                <label>Default model<select name="defaultModelId"><option value="">None</option>@foreach (var m in Model.State.Models.Where(x => x.IsEnabled)) { <option value="@m.Id">@m.Name</option> }</select></label>
                <label class="wide">Description<input name="description" maxlength="500" /></label>
                <label class="wide">Project system prompt<textarea name="systemPrompt" rows="4" placeholder="Instructions applied to every job in this project"></textarea></label>
                <button>Create project</button>
            </form>
        </details>
    }
    @if (!Model.VisibleProjects.Any()) { <div class="empty">No projects are available yet.</div> }
    @foreach (var project in Model.VisibleProjects)
    {
        var loops = Model.State.Loops.Where(x => x.ProjectId == project.Id).ToList();
        var repositoryLinks = Model.State.ProjectRepositories.Where(x => x.ProjectId == project.Id).Select(link => Model.State.GitHubConnections.SelectMany(connection => connection.Repositories).FirstOrDefault(repository => repository.Id == link.RepositoryId)).Where(x => x is not null).ToList();
        <details class="project-card project-disclosure">
            <summary class="project-head"><div><span class="dot"></span><h2>@project.Name</h2><p>@project.Description</p></div><span class="pill">@loops.Count loops</span></summary>
            <div class="project-disclosure-body">
            @if (repositoryLinks.Count > 0) { <div class="repository-links">@foreach (var repository in repositoryLinks) { <a href="@repository!.HtmlUrl" target="_blank" rel="noopener">@repository.FullName</a> }</div> }
            <a class="button project-files" asp-controller="Files" asp-action="Index" asp-route-projectId="@project.Id">Manage folders & files →</a>
            @if (CanManage(project.Id))
            {
                <details><summary>Edit project & prompt</summary>
                    <form asp-controller="Manage" asp-action="UpdateProject" method="post" class="form-grid compact"><input type="hidden" name="id" value="@project.Id" />
                        <label>Name<input name="name" value="@project.Name" required /></label><label>Default model<select name="defaultModelId"><option value="">None</option>@foreach (var m in Model.State.Models.Where(x => x.IsEnabled)) { <option value="@m.Id" selected="@(m.Id == project.DefaultModelId)">@m.Name</option> }</select></label>
                        <label class="wide">Description<input name="description" value="@project.Description" /></label><label class="wide">System prompt<textarea name="systemPrompt" rows="4">@project.SystemPrompt</textarea></label><button>Save changes</button>
                    </form>
                </details>
                <details><summary>Add recurring loop</summary>
                    <form asp-controller="Manage" asp-action="CreateLoop" method="post" class="form-grid compact"><input type="hidden" name="projectId" value="@project.Id" />
                        <label>Name<input name="name" required /></label><label>Every (seconds)<input name="intervalSeconds" type="number" min="10" value="300" required /></label><label>Execution limit<input name="maxExecutions" type="number" min="1" step="1" placeholder="Unlimited" /></label><label class="wide">Loop prompt<textarea name="prompt" rows="3" required></textarea></label><label class="check"><input type="checkbox" name="isEnabled" value="true" /> Enable now</label><button>Add loop</button>
                    </form>
                </details>
            }
            <div class="loop-list" data-disclosure-scope>
                @if (loops.Any()) { <div class="disclosure-toolbar"><button type="button" class="secondary" data-disclosure-action="expand" data-disclosure-target=".loop-item">Expand all loops</button><button type="button" class="secondary" data-disclosure-action="collapse" data-disclosure-target=".loop-item">Collapse all loops</button></div> }
                @foreach (var loop in loops)
                {
                    <details class="loop-item" data-disclosure-id="loop-@loop.Id"><summary><span class="status @(loop.IsEnabled ? "online" : "")"></span><strong>@loop.Name</strong><small>every @loop.IntervalSeconds sec · @loop.ExecutionCount run@(loop.ExecutionCount == 1 ? "" : "s") · @(loop.LastQueuedAt?.ToLocalTime().ToString("g") ?? "not run") · limit @(loop.MaxExecutions?.ToString() ?? "unlimited")</small></summary><div class="loop-item-body"><p>@loop.Prompt</p>
                        @if (CanManage(project.Id)) { <form asp-controller="Manage" asp-action="SetLoopExecutionLimit" method="post" class="loop-limit-form"><input type="hidden" name="id" value="@loop.Id"/><label>Execution limit<input name="maxExecutions" type="number" min="1" step="1" value="@loop.MaxExecutions" placeholder="Unlimited" /></label><button class="secondary">Save limit</button><small>Leave blank for unlimited retries.</small></form> }
                        @if (CanManage(project.Id)) { <div class="actions"><form asp-controller="Manage" asp-action="ToggleLoop" method="post"><input type="hidden" name="id" value="@loop.Id"/><button class="secondary">@(loop.IsEnabled ? "Stop" : "Start")</button></form><form asp-controller="Manage" asp-action="DeleteLoop" method="post" onsubmit="return confirm('Delete this loop?')"><input type="hidden" name="id" value="@loop.Id"/><button class="danger">Delete</button></form></div> }
                    </div></details>
                }
            </div>
            @if (CanRun(project.Id))
            {
                <form asp-controller="Manage" asp-action="RunJob" method="post" class="run-box"><input type="hidden" name="projectId" value="@project.Id"/><textarea name="prompt" rows="2" required placeholder="Ask the agent to read or work with project files…"></textarea><div class="run-options"><select name="modelId"><option value="">Automatic model fallback</option>@foreach (var m in Model.State.Models.Where(x => x.IsEnabled)) { <option value="@m.Id">@m.Name</option> }</select><select name="requiredCapability"><option value="Orchestrator">Orchestrator</option>@foreach (var capability in AiCapabilities.All.Where(item => item != AiCapabilities.Orchestrator)) { <option value="@capability">@capability</option> }</select><select name="conversationId"><option value="">New conversation</option>@foreach (var c in Model.State.Conversations.Where(x => x.ProjectId == project.Id).OrderByDescending(x => x.UpdatedAt)) { <option value="@c.Id">Continue: @c.Title</option> }</select></div><button>Run agent →</button>
                </form>
            }
            @if (Model.IsAdmin) { <form asp-controller="Manage" asp-action="DeleteProject" method="post" class="delete-project" onsubmit="return confirm('Delete this project and all its data?')"><input type="hidden" name="id" value="@project.Id"/><button class="link-danger">Delete project</button></form> }
            </div>
        </details>
    }
</section>

<section id="steps" class="panel tab-panel" data-disclosure-scope>
    <div class="section-title"><div><p class="eyebrow">SERVER-MANAGED WORKFLOW</p><h2>Steps</h2><p class="muted">AI proposes the plan; the server owns step order, attempts, retries, and outcomes. PLAN.md is restored from this record if it is deleted.</p></div><div class="export-actions"><button type="button" class="secondary" data-disclosure-action="expand" data-disclosure-target=".plan-board">Expand all</button><button type="button" class="secondary" data-disclosure-action="collapse" data-disclosure-target=".plan-board">Collapse all</button><a class="button secondary" asp-controller="Export" asp-action="Plans">Export CSV</a></div></div>
    <div id="plan-steps-list" data-plan-steps-url="@Url.Action("PlanStepsPartial", "Home")" data-disclosure-scope>@await Html.PartialAsync("_PlanSteps", Model)</div>
</section>

<section id="files" class="panel tab-panel" data-disclosure-scope>
    <div class="section-title"><div><h2>Files</h2><p class="muted">Upload, create folders, preview, edit, or safely remove project files.</p></div><a class="button secondary" asp-controller="Export" asp-action="Files">Export CSV</a></div>
    @if (!Model.VisibleProjects.Any()) { <div class="empty">No project workspaces are available yet.</div> }
    @if (Model.VisibleProjects.Any())
    {
        <div class="file-project-switcher">
            <select aria-label="Project" data-file-project-select>@foreach (var project in Model.VisibleProjects) { <option value="@project.Id" data-workspace-url="@Url.Action("WorkspacePartial", "Files", new { projectId = project.Id })">@project.Name</option> }</select>
        </div>
        <div class="disclosure-toolbar"><button type="button" class="secondary" data-disclosure-action="expand" data-disclosure-target=".file-project-disclosure">Expand project</button><button type="button" class="secondary" data-disclosure-action="collapse" data-disclosure-target=".file-project-disclosure">Collapse project</button></div>
        <details class="file-project-disclosure" open><summary data-file-project-summary>Project files</summary><div class="dashboard-inline-workspace selected-project-workspace" data-selected-workspace></div></details>
    }
</section>

<section id="jobs" class="panel tab-panel">
    <div class="section-title"><div><p class="eyebrow">EXECUTION HISTORY</p><h2>Jobs</h2></div><a class="button secondary" asp-controller="Export" asp-action="Jobs">Export CSV</a></div>
    <div id="jobs-list" data-jobs-url="@Url.Action("JobsPartial", "Home")">@await Html.PartialAsync("_JobsList", Model)</div>
</section>

<section id="chats" class="panel tab-panel">
    <div class="section-title"><div><p class="eyebrow">REQUEST, RESPONSE & ACTIVITY HISTORY</p><h2>Messages</h2><p class="muted">System messages, chats, AI responses, and tool calls update independently without refreshing the page.</p></div></div>
    <section class="live-history-panel" data-disclosure-scope>
        <header class="live-history-head"><div><h3>Warnings, errors, and system messages</h3><p>Newest first · scroll for older messages</p></div><div class="live-history-actions"><button type="button" class="secondary" data-disclosure-action="expand" data-disclosure-target=".message-item">Expand</button><button type="button" class="secondary" data-disclosure-action="collapse" data-disclosure-target=".message-item">Collapse</button><a class="button secondary" asp-controller="Export" asp-action="Messages">CSV</a>@if (Model.IsAdmin) { <form asp-controller="Manage" asp-action="ClearMessages" method="post" data-live-clear data-clear-target="messages-list" data-confirm="Clear all warnings, errors, and system messages?"><button class="link-danger">Clear</button></form> }</div></header>
        <div id="messages-list" data-live-list="messages" data-live-url="@Url.Action("MessagesPartial", "Home")">@await Html.PartialAsync("_MessagesList", Model)</div>
    </section>
    <section class="live-history-panel" data-disclosure-scope>
        <header class="live-history-head"><div><h3>Chats</h3><p>Newest first · scroll for older chats</p></div><div class="live-history-actions"><button type="button" class="secondary" data-disclosure-action="expand" data-disclosure-target=".chat-thread">Expand</button><button type="button" class="secondary" data-disclosure-action="collapse" data-disclosure-target=".chat-thread">Collapse</button><a class="button secondary" asp-controller="Export" asp-action="Chats">CSV</a>@if (Model.IsAdmin) { <form asp-controller="Manage" asp-action="ClearChats" method="post" data-live-clear data-clear-target="chats-list" data-confirm="Clear all saved chats?"><button class="link-danger">Clear</button></form> }</div></header>
        <div id="chats-list" data-live-list="chats" data-live-url="@Url.Action("ChatsPartial", "Home")">@await Html.PartialAsync("_ChatsList", Model)</div>
    </section>
    @if (Model.IsAdmin)
    {
        <section class="live-history-panel" data-disclosure-scope>
            <header class="live-history-head"><div><h3>Tool calls</h3><p>AI project-tool requests and their saved results</p></div><div class="live-history-actions"><button type="button" class="secondary" data-disclosure-action="expand" data-disclosure-target=".runtime-audit-item">Expand</button><button type="button" class="secondary" data-disclosure-action="collapse" data-disclosure-target=".runtime-audit-item">Collapse</button><a class="button secondary" asp-controller="Export" asp-action="Tools">CSV</a><form asp-controller="AgentRuntime" asp-action="ClearAudit" method="post" onsubmit="return confirm('Clear the tool activity history?')"><button class="link-danger">Clear</button></form></div></header>
            <div id="tool-audit-list" data-tool-audit-url="@Url.Action("ToolAuditPartial", "Home")">@await Html.PartialAsync("_ToolAuditList", Model)</div>
        </section>
    }
</section>

@if (Model.IsAdmin)
{
<section id="workspace" class="panel tab-panel">
    @await Html.PartialAsync("_ToolConfiguration", Model)
</section>

<section id="connections" class="panel tab-panel" data-disclosure-scope>
    <div class="section-title"><div><p class="eyebrow">SERVICES & MODEL ROUTING</p><h2>Connections</h2><p class="muted">Models are tried by capability and priority. If one fails, the same job continues with the next eligible connection.</p></div><div class="export-actions"><button type="button" class="secondary" data-disclosure-action="expand" data-disclosure-target=".connection-card,.github-card">Expand all</button><button type="button" class="secondary" data-disclosure-action="collapse" data-disclosure-target=".connection-card,.github-card">Collapse all</button><a class="button secondary" asp-controller="Export" asp-action="Models">Export CSV</a></div></div>
    <details class="create-box connection-creator"><summary>＋ Add connection</summary>
        <form asp-controller="Manage" asp-action="CreateModel" method="post" class="form-grid" data-ai-connection-form>
            <label>Connection type<select name="providerId" data-ai-provider data-icon-select>@foreach (var provider in Model.State.AiProviderCatalog) { <option value="@provider.Id" data-base-url="@provider.BaseUrl">@provider.Name</option> }</select></label>
            <label>Display name<input name="name" required placeholder="My AI connection" /></label>
            <label>Model<select data-ai-model-select data-icon-select required><option value="">Select a model</option></select><span class="model-discovery-actions"><button type="button" class="secondary compact-button" data-ai-load-models>Load live models</button><small data-ai-discovery-status aria-live="polite"></small></span></label><label data-ai-custom-model hidden>Other model ID<input data-ai-custom-model-input autocomplete="off" spellcheck="false" /></label><input type="hidden" name="modelId" data-ai-model-value />
            <label>Priority<input name="priority" type="number" min="1" max="999" value="100" /><small>Lower numbers are tried first.</small></label>
            <label class="wide">Base URL<input name="baseUrl" type="url" required value="@Model.State.AiProviderCatalog.FirstOrDefault()?.BaseUrl" /></label>
            <label data-ai-authentication>Authentication<select name="authenticationType" data-ai-authentication-select>@foreach (var type in AiAuthenticationTypes.All) { <option value="@type">@type</option> }</select></label>
            <label data-ai-key-header hidden>Header name<input name="apiKeyHeaderName" value="api-key" /></label>
            <label class="wide" data-ai-api-key>API credential<input name="apiKey" type="password" autocomplete="off" /></label>
            <fieldset class="wide capability-picker"><legend>Active capabilities</legend>@foreach (var capability in AiCapabilities.All) { <label class="check" data-ai-capability="@capability"><input type="checkbox" name="capabilities" value="@capability" /> @capability</label> }</fieldset>
            <div class="wide provider-links" data-provider-links></div><label class="check"><input type="checkbox" name="isEnabled" value="true" checked /> Active</label><button>Add AI connection</button>
        </form>
    </details>
    <script type="application/json" id="ai-provider-catalog">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.State.AiProviderCatalog, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))</script>
    <form id="bulk-ai-connections" asp-controller="Manage" asp-action="BulkModels" method="post" class="connection-bulk-actions"><strong>@Model.State.Models.Count AI connection(s)</strong><button name="action" value="activate" class="secondary">Activate selected</button><button name="action" value="deactivate" class="secondary">Deactivate selected</button><button name="action" value="delete" class="danger" onclick="return confirm('Delete selected AI connections?')">Delete selected</button></form>
    <div class="connection-list">
    @foreach (var m in Model.State.Models.OrderBy(item => item.Priority).ThenBy(item => item.Name))
    {
        var provider = Model.State.AiProviderCatalog.FirstOrDefault(item => item.Id == m.ProviderId);
        <details class="connection-card @(m.IsEnabled ? "active" : "inactive")">
            <summary><label class="connection-select"><input form="bulk-ai-connections" type="checkbox" name="selectedIds" value="@m.Id" aria-label="Select @m.Name" /></label><span class="status @(m.IsEnabled ? "online" : "")"></span><div><h3>@m.Name</h3><p>@(provider?.Name ?? m.ProviderId) · <code>@m.ModelId</code> · priority @m.Priority</p></div><span class="pill">@(m.IsEnabled ? "active" : "inactive")</span></summary>
            <div class="capability-row" aria-label="Capabilities for @m.Name">
                @foreach (var capability in m.SuggestedCapabilities.Count > 0 ? m.SuggestedCapabilities.AsEnumerable() : AiCapabilities.All.AsEnumerable())
                {
                    <label class="capability-chip"><input type="checkbox" checked="@(m.Capabilities.Contains(capability, StringComparer.OrdinalIgnoreCase))" data-model-capability data-model-id="@m.Id" value="@capability" /> @capability</label>
                }
            </div>
            @if (m.Capabilities.Count == 0) { <p class="capability-default">Using predefined capabilities: @string.Join(", ", m.SuggestedCapabilities.DefaultIfEmpty("Generator"))</p> }
            <div class="connection-meta"><span>@m.ApiProtocol</span><span>@m.BaseUrl</span><span>@m.AuthenticationType</span><span>Test: @m.LastTestStatus@(m.LastTestedAt is null ? "" : $" · {m.LastTestedAt.Value.ToLocalTime():g}")</span>@if (!string.IsNullOrWhiteSpace(m.LastTestMessage)) { <small>@m.LastTestMessage</small> }</div>
            <div class="actions"><form asp-controller="Manage" asp-action="TestModel" method="post"><input type="hidden" name="id" value="@m.Id"/><button class="secondary">Test request</button></form><button type="button" class="secondary" data-ai-load-saved-models data-connection-id="@m.Id" data-provider-id="@m.ProviderId" data-base-url="@m.BaseUrl" data-target-list="models-@m.Id">Load live models</button><small data-ai-saved-discovery-status aria-live="polite"></small><form asp-controller="Manage" asp-action="ToggleModel" method="post"><input type="hidden" name="id" value="@m.Id"/><button class="secondary">@(m.IsEnabled ? "Deactivate" : "Activate")</button></form><details><summary>Edit</summary><form asp-controller="Manage" asp-action="UpdateModel" method="post" class="form-grid compact"><input type="hidden" name="id" value="@m.Id"/><input type="hidden" name="providerId" value="@m.ProviderId"/><input type="hidden" name="authenticationType" value="@m.AuthenticationType"/><input type="hidden" name="apiKeyHeaderName" value="@m.ApiKeyHeaderName"/><label>Name<input name="name" value="@m.Name" required /></label><label>Model ID<input name="modelId" value="@m.ModelId" list="models-@m.Id" required /><datalist id="models-@m.Id">@foreach (var choice in provider?.Models ?? []) { if (choice.Id != "custom") { <option value="@choice.Id">@choice.Name</option> } }</datalist></label><label>Priority<input name="priority" type="number" min="1" max="999" value="@m.Priority" /></label>@if (m.AuthenticationType != AiAuthenticationTypes.None) { <label>New credential<input name="apiKey" type="password" placeholder="Leave blank to keep current" /></label> }<label class="wide">Base URL<input name="baseUrl" type="url" value="@m.BaseUrl" required /></label><button>Save</button></form></details><form asp-controller="Manage" asp-action="DeleteModel" method="post" onsubmit="return confirm('Delete this AI connection?')"><input type="hidden" name="id" value="@m.Id"/><button class="link-danger">Delete</button></form></div>
        </details>
    }
    </div>
    <section class="connection-subsection">
        <div class="section-title"><div><p class="eyebrow">OBJECT STORAGE</p><h2>S3 / Spaces</h2><p class="muted">Save several storage connections and activate the one that should mirror project files.</p></div><span class="pill">@(Model.State.ObjectStorageConnections.Any(item => item.IsEnabled) ? "active" : "local fallback")</span></div>
        <details class="create-box connection-creator"><summary>＋ Add object-storage connection</summary>
            <form asp-controller="Manage" asp-action="CreateStorageConnection" method="post" class="form-grid" data-storage-connection-form>
                <label>Connection type<select name="provider" data-storage-provider>@foreach (var provider in ObjectStorageProviders.All) { <option value="@provider">@provider</option> }</select></label>
                <label>Display name<input name="name" required placeholder="Project storage" /></label>
                <label>Bucket<input name="bucket" required autocomplete="off" /></label>
                <label data-storage-region>Region<input name="region" value="us-east-1" required /></label>
                <label class="wide" data-storage-endpoint hidden>Endpoint<input name="endpoint" type="url" placeholder="https://region.digitaloceanspaces.com" /></label>
                <label class="wide">Folder prefix<input name="prefix" value="dan-loop/projects" /><small>All project namespaces are stored below this folder.</small></label>
                <label>Access key<input name="accessKey" type="password" required autocomplete="off" /></label>
                <label>Secret key<input name="secretKey" type="password" required autocomplete="off" /></label>
                <label data-storage-session>Session token<input name="sessionToken" type="password" autocomplete="off" placeholder="Optional" /></label>
                <label class="check" data-storage-path-style hidden><input type="checkbox" name="forcePathStyle" value="true" /> Force path-style URLs</label>
                <div class="wide provider-links" data-storage-links><a href="https://aws.amazon.com/s3/pricing/" target="_blank" rel="noopener">Pricing ↗</a><a href="https://docs.aws.amazon.com/AmazonS3/latest/userguide/GetStartedWithS3.html" target="_blank" rel="noopener">Documentation ↗</a></div>
                <label class="check"><input type="checkbox" name="isEnabled" value="true" checked /> Active</label><button>Add storage connection</button>
            </form>
        </details>
        <form id="bulk-storage-connections" asp-controller="Manage" asp-action="BulkStorageConnections" method="post" class="connection-bulk-actions"><strong>@Model.State.ObjectStorageConnections.Count storage connection(s)</strong><button name="action" value="activate" class="secondary">Activate selected</button><button name="action" value="deactivate" class="secondary">Deactivate selected</button><button name="action" value="delete" class="danger" onclick="return confirm('Delete selected storage connections?')">Delete selected</button></form>
        <div class="connection-list">
        @foreach (var storage in Model.State.ObjectStorageConnections.OrderByDescending(item => item.IsEnabled).ThenBy(item => item.Name))
        {
            <details class="connection-card @(storage.IsEnabled ? "active" : "inactive")">
                <summary><label class="connection-select"><input form="bulk-storage-connections" type="checkbox" name="selectedIds" value="@storage.Id" aria-label="Select @storage.Name" /></label><span class="status @(storage.IsEnabled ? "online" : "")"></span><div><h3>@storage.Name</h3><p>@storage.Provider · <code>@storage.Bucket</code></p></div><span class="pill">@(storage.IsEnabled ? "active" : "inactive")</span></summary>
                <div class="connection-meta"><span>@(string.IsNullOrWhiteSpace(storage.Endpoint) ? $"AWS · {storage.Region}" : storage.Endpoint)</span><span>Prefix: @storage.Prefix</span><span>Test: @storage.LastTestStatus@(storage.LastTestedAt is null ? "" : $" · {storage.LastTestedAt.Value.ToLocalTime():g}")</span>@if (!string.IsNullOrWhiteSpace(storage.LastTestMessage)) { <small>@storage.LastTestMessage</small> }</div>
                <div class="actions"><form asp-controller="Manage" asp-action="TestStorageConnection" method="post"><input type="hidden" name="id" value="@storage.Id"/><button class="secondary">Test connection</button></form><form asp-controller="Manage" asp-action="ToggleStorageConnection" method="post"><input type="hidden" name="id" value="@storage.Id"/><button class="secondary">@(storage.IsEnabled ? "Deactivate" : "Activate")</button></form><details><summary>Edit</summary><form asp-controller="Manage" asp-action="UpdateStorageConnection" method="post" class="form-grid compact" data-storage-connection-form><input type="hidden" name="id" value="@storage.Id"/><label>Type<select name="provider" data-storage-provider>@foreach (var provider in ObjectStorageProviders.All) { <option value="@provider" selected="@(provider == storage.Provider)">@provider</option> }</select></label><label>Name<input name="name" value="@storage.Name" required /></label><label>Bucket<input name="bucket" value="@storage.Bucket" required /></label><label data-storage-region>Region<input name="region" value="@storage.Region" required /></label><label class="wide" data-storage-endpoint>Endpoint<input name="endpoint" type="url" value="@storage.Endpoint" /></label><label class="wide">Folder prefix<input name="prefix" value="@storage.Prefix" /></label><label>New access key<input name="accessKey" type="password" placeholder="Keep current" /></label><label>New secret key<input name="secretKey" type="password" placeholder="Keep current" /></label><label data-storage-session>New session token<input name="sessionToken" type="password" placeholder="Keep current" /></label><label class="check" data-storage-path-style><input type="checkbox" name="forcePathStyle" value="true" checked="@storage.ForcePathStyle" /> Force path-style URLs</label><button>Save</button></form></details><form asp-controller="Manage" asp-action="DeleteStorageConnection" method="post" onsubmit="return confirm('Delete this storage connection? Files already stored remotely will not be deleted.')"><input type="hidden" name="id" value="@storage.Id"/><button class="link-danger">Delete</button></form></div>
            </details>
        }
        </div>
        @if (!Model.State.ObjectStorageConnections.Any()) { <div class="empty">No object-storage connection yet. Project files remain safely available in local storage.</div> }
    </section>
    <div class="connection-subsection">
    <div class="section-title"><div><p class="eyebrow">SOURCE CONTROL & AUTOMATION</p><h2>GitHub connections</h2></div><a class="button secondary" asp-controller="Export" asp-action="GitHub">Export CSV</a></div>
    <details class="create-box"><summary>＋ Connect with fine-grained token</summary>
        <form asp-controller="GitHub" asp-action="ConnectToken" method="post" class="form-grid compact">
            <input type="hidden" name="returnUrl" value="/#connections" />
            <label class="wide">Fine-grained access token<input name="token" type="password" required autocomplete="off" spellcheck="false" placeholder="github_pat_…" /></label>
            <p class="wide form-help"><a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">Create a fine-grained token on GitHub ↗</a>. Repository access and capabilities are limited to what you select there. The token is encrypted at rest.</p>
            <button>Connect GitHub</button>
        </form>
    </details>
    @if (GitHub.IsConfigured) { <details class="configuration-note"><summary>Advanced GitHub App connection</summary><a class="button secondary" asp-controller="GitHub" asp-action="Connect" asp-route-returnUrl="/#connections">Connect configured GitHub App</a></details> }
    @if (!Model.State.GitHubConnections.Any())
    {
        <div class="empty">No GitHub accounts are connected yet.</div>
    }
    @foreach (var connection in Model.State.GitHubConnections)
    {
        <details class="github-card">
            <summary class="project-head"><div><h3>@connection.AccountLogin</h3><p>@connection.AuthenticationType authentication · @connection.AccountType · @connection.Repositories.Count repositories · refreshed @connection.RefreshedAt.ToLocalTime().ToString("g")</p></div><span class="pill">GitHub</span></summary>
            <div class="actions">@if (!string.IsNullOrWhiteSpace(connection.SettingsUrl)) { <a class="button secondary" href="@connection.SettingsUrl">Manage on GitHub</a> }<form asp-controller="GitHub" asp-action="Refresh" method="post"><input type="hidden" name="id" value="@connection.Id"/><button class="secondary">Refresh</button></form><form asp-controller="GitHub" asp-action="Delete" method="post" onsubmit="return confirm('Remove this GitHub connection from the server?')"><input type="hidden" name="id" value="@connection.Id"/><button class="link-danger">Remove</button></form></div>
            @foreach (var project in Model.State.Projects)
            {
                var selected = Model.State.ProjectRepositories.Where(x => x.ProjectId == project.Id && x.GitHubConnectionId == connection.Id).Select(x => x.RepositoryId).ToHashSet();
                <form asp-controller="GitHub" asp-action="SetProjectRepositories" method="post" class="repository-map">
                    <input type="hidden" name="projectId" value="@project.Id"/><input type="hidden" name="connectionId" value="@connection.Id"/>
                    <strong>@project.Name</strong>
                    <div class="repository-options">
                        @foreach (var repository in connection.Repositories)
                        {
                            <label class="check"><input type="checkbox" name="repositoryIds" value="@repository.Id" checked="@(selected.Contains(repository.Id))"/> @repository.FullName <small>@(repository.IsPrivate ? "private" : "public")</small></label>
                        }
                    </div>
                    <button class="secondary">Save repositories</button>
                </form>
                @foreach (var repository in connection.Repositories.Where(x => selected.Contains(x.Id))) { <form asp-controller="GitHub" asp-action="ImportRepository" method="post" class="import-repository"><input type="hidden" name="projectId" value="@project.Id"/><input type="hidden" name="repositoryId" value="@repository.Id"/><button class="secondary">Import fresh copy of @repository.FullName</button></form> }
            }
        </details>
    }
    @foreach (var project in Model.State.Projects)
    {
        var mapped = Model.State.ProjectRepositories.Where(x => x.ProjectId == project.Id).Select(x => x.RepositoryId).ToHashSet();
        var choices = Model.State.GitHubConnections.SelectMany(x => x.Repositories).Where(x => mapped.Contains(x.Id)).ToList();
        <form asp-controller="GitHub" asp-action="SetResultsRepository" method="post" class="create-box form-grid"><input type="hidden" name="projectId" value="@project.Id"/><label>@project.Name result destination<select name="repositoryId"><option value="">Local project results folder</option>@foreach (var repository in choices) { <option value="@repository.Id" selected="@(project.ResultsRepositoryId == repository.Id)">@repository.FullName</option> }</select></label><button>Save destination</button></form>
    }
    </div>
</section>

<section id="access" class="panel tab-panel" data-disclosure-scope>
    <div class="section-title"><div><p class="eyebrow">ACCOUNTS & PROJECT PERMISSIONS</p><h2>Users</h2></div><div class="export-actions"><button type="button" class="secondary" data-disclosure-action="expand" data-disclosure-target=".user-card">Expand all</button><button type="button" class="secondary" data-disclosure-action="collapse" data-disclosure-target=".user-card">Collapse all</button><a class="button secondary" asp-controller="Export" asp-action="Access">Export CSV</a></div></div>
    <form asp-controller="Manage" asp-action="CreateUser" method="post" class="form-grid create-box open"><label>Username<input name="username" required /></label><label>Password<input name="password" type="password" minlength="10" required /></label><label>Role<select name="role"><option value="Member">Member</option><option value="Admin">Admin</option></select></label><button>Create user</button></form>
    @foreach (var user in Model.State.Users)
    {
        <details class="user-card"><summary class="user-head"><div><strong>@user.Username</strong><span class="pill">@user.Role · @(user.IsEnabled ? "enabled" : "disabled")</span></div><span class="pill">Manage</span></summary>
        <div class="user-management"><form asp-controller="Manage" asp-action="UpdateUser" method="post" class="form-grid compact"><input type="hidden" name="id" value="@user.Id"/><label>Role<select name="role"><option value="Member" selected="@(user.Role == Roles.Member)">Member</option><option value="Admin" selected="@(user.Role == Roles.Admin)">Admin</option></select></label><label>New password<input name="password" type="password" minlength="10" placeholder="Leave blank to keep current" /></label><button class="secondary">Save user</button></form>@if (user.Id != Model.CurrentUserId) { <div class="actions"><form asp-controller="Manage" asp-action="ToggleUser" method="post"><input type="hidden" name="id" value="@user.Id"/><button class="secondary">@(user.IsEnabled ? "Disable" : "Enable")</button></form><form asp-controller="Manage" asp-action="DeleteUser" method="post" onsubmit="return confirm('Delete this user and their project permissions?')"><input type="hidden" name="id" value="@user.Id"/><button class="danger">Delete user</button></form></div> }</div>
        @if (user.Role != Roles.Admin) { <div class="permissions">@foreach (var project in Model.State.Projects) { var permission = Model.State.Permissions.FirstOrDefault(x => x.UserId == user.Id && x.ProjectId == project.Id); <form asp-controller="Manage" asp-action="SetPermission" method="post"><input type="hidden" name="userId" value="@user.Id"/><input type="hidden" name="projectId" value="@project.Id"/><strong>@project.Name</strong><label class="check"><input type="checkbox" name="canView" value="true" checked="@(permission?.CanView == true)"/> View</label><label class="check"><input type="checkbox" name="canManage" value="true" checked="@(permission?.CanManage == true)"/> Manage</label><label class="check"><input type="checkbox" name="canRun" value="true" checked="@(permission?.CanRun == true)"/> Run</label><button class="secondary">Save</button></form> }</div> }
        </details>
    }
</section>
}
