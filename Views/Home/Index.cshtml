@model DashboardViewModel
@inject GitHubService GitHub
@inject S3ObjectStorage ObjectStorage
@{
    ViewData["Title"] = "Dashboard";
    bool CanManage(Guid projectId) => Model.IsAdmin || Model.State.Permissions.Any(x => x.UserId == Model.CurrentUserId && x.ProjectId == projectId && x.CanManage);
    bool CanRun(Guid projectId) => Model.IsAdmin || Model.State.Permissions.Any(x => x.UserId == Model.CurrentUserId && x.ProjectId == projectId && x.CanRun);
}

<section class="hero">
    <div><p class="eyebrow">ORCHESTRATION CONTROL PLANE</p><h1>Loops that keep moving.</h1><p>Manage prompts, recurring work, remote models and access from one local dashboard.</p></div>
    <div class="metrics"><div><strong>@Model.VisibleProjects.Count</strong><span>projects</span></div><div><strong>@Model.State.Loops.Count(x => x.IsEnabled)</strong><span>live loops</span></div></div>
</section>

@if (TempData["Message"] is string message) { <div class="notice">@message</div> }

<nav class="tabs">
    <button class="tab active" data-tab="projects">Projects</button><button class="tab" data-tab="steps">Execution plan</button><button class="tab" data-tab="files">Folders & files</button><button class="tab" data-tab="jobs">Jobs</button><button class="tab" data-tab="chats">Chats</button>
    @if (Model.IsAdmin) { <button class="tab" data-tab="tools">Tools</button><button class="tab advanced-tab" data-tab="workspace">AI workspace access <small>Advanced</small></button><button class="tab" data-tab="connections">Connections</button><button class="tab" data-tab="access">Access</button> }
</nav>

<section id="projects" class="panel tab-panel active">
    <div class="export-toolbar"><a class="button secondary" asp-controller="Export" asp-action="Projects">Export projects CSV</a><a class="button secondary" asp-controller="Export" asp-action="Loops">Export loops CSV</a></div>
    @if (Model.IsAdmin)
    {
        <details class="create-box"><summary>＋ New project</summary>
            <form asp-controller="Manage" asp-action="CreateProject" method="post" class="form-grid">
                <label>Name<input name="name" required maxlength="100" /></label>
                <label>Default model<select name="defaultModelId"><option value="">None</option>@foreach (var m in Model.State.Models.Where(x => x.IsEnabled)) { <option value="@m.Id">@m.Name</option> }</select></label>
                <label class="wide">Description<input name="description" maxlength="500" /></label>
                <label class="wide">Project system prompt<textarea name="systemPrompt" rows="4" placeholder="Instructions applied to every job in this project"></textarea></label>
                <button>Create project</button>
            </form>
        </details>
    }
    @if (!Model.VisibleProjects.Any()) { <div class="empty">No projects are available yet.</div> }
    @foreach (var project in Model.VisibleProjects)
    {
        var loops = Model.State.Loops.Where(x => x.ProjectId == project.Id).ToList();
        var repositoryLinks = Model.State.ProjectRepositories.Where(x => x.ProjectId == project.Id).Select(link => Model.State.GitHubConnections.SelectMany(connection => connection.Repositories).FirstOrDefault(repository => repository.Id == link.RepositoryId)).Where(x => x is not null).ToList();
        <article class="project-card">
            <div class="project-head"><div><span class="dot"></span><h2>@project.Name</h2><p>@project.Description</p></div><span class="pill">@loops.Count loops</span></div>
            @if (repositoryLinks.Count > 0) { <div class="repository-links">@foreach (var repository in repositoryLinks) { <a href="@repository!.HtmlUrl" target="_blank" rel="noopener">@repository.FullName</a> }</div> }
            <a class="button project-files" asp-controller="Files" asp-action="Index" asp-route-projectId="@project.Id">Manage folders & files →</a>
            @if (CanManage(project.Id))
            {
                <details><summary>Edit project & prompt</summary>
                    <form asp-controller="Manage" asp-action="UpdateProject" method="post" class="form-grid compact"><input type="hidden" name="id" value="@project.Id" />
                        <label>Name<input name="name" value="@project.Name" required /></label><label>Default model<select name="defaultModelId"><option value="">None</option>@foreach (var m in Model.State.Models.Where(x => x.IsEnabled)) { <option value="@m.Id" selected="@(m.Id == project.DefaultModelId)">@m.Name</option> }</select></label>
                        <label class="wide">Description<input name="description" value="@project.Description" /></label><label class="wide">System prompt<textarea name="systemPrompt" rows="4">@project.SystemPrompt</textarea></label><button>Save changes</button>
                    </form>
                </details>
                <details><summary>Add recurring loop</summary>
                    <form asp-controller="Manage" asp-action="CreateLoop" method="post" class="form-grid compact"><input type="hidden" name="projectId" value="@project.Id" />
                        <label>Name<input name="name" required /></label><label>Every (seconds)<input name="intervalSeconds" type="number" min="10" value="300" required /></label><label>Execution limit<input name="maxExecutions" type="number" min="1" step="1" placeholder="Unlimited" /></label><label class="wide">Loop prompt<textarea name="prompt" rows="3" required></textarea></label><label class="check"><input type="checkbox" name="isEnabled" value="true" /> Enable now</label><button>Add loop</button>
                    </form>
                </details>
            }
            <div class="loop-list" data-disclosure-scope>
                @if (loops.Any()) { <div class="disclosure-toolbar"><button type="button" class="secondary" data-disclosure-action="expand" data-disclosure-target=".loop-item">Expand all loops</button><button type="button" class="secondary" data-disclosure-action="collapse" data-disclosure-target=".loop-item">Collapse all loops</button></div> }
                @foreach (var loop in loops)
                {
                    <details class="loop-item" data-disclosure-id="loop-@loop.Id"><summary><span class="status @(loop.IsEnabled ? "online" : "")"></span><strong>@loop.Name</strong><small>every @loop.IntervalSeconds sec · @loop.ExecutionCount run@(loop.ExecutionCount == 1 ? "" : "s") · @(loop.LastQueuedAt?.ToLocalTime().ToString("g") ?? "not run") · limit @(loop.MaxExecutions?.ToString() ?? "unlimited")</small></summary><div class="loop-item-body"><p>@loop.Prompt</p>
                        @if (CanManage(project.Id)) { <form asp-controller="Manage" asp-action="SetLoopExecutionLimit" method="post" class="loop-limit-form"><input type="hidden" name="id" value="@loop.Id"/><label>Execution limit<input name="maxExecutions" type="number" min="1" step="1" value="@loop.MaxExecutions" placeholder="Unlimited" /></label><button class="secondary">Save limit</button><small>Leave blank for unlimited retries.</small></form> }
                        @if (CanManage(project.Id)) { <div class="actions"><form asp-controller="Manage" asp-action="ToggleLoop" method="post"><input type="hidden" name="id" value="@loop.Id"/><button class="secondary">@(loop.IsEnabled ? "Pause" : "Enable")</button></form><form asp-controller="Manage" asp-action="DeleteLoop" method="post" onsubmit="return confirm('Delete this loop?')"><input type="hidden" name="id" value="@loop.Id"/><button class="danger">Delete</button></form></div> }
                    </div></details>
                }
            </div>
            @if (CanRun(project.Id))
            {
                <form asp-controller="Manage" asp-action="RunJob" method="post" class="run-box"><input type="hidden" name="projectId" value="@project.Id"/><textarea name="prompt" rows="2" required placeholder="Ask the agent to read or work with project files…"></textarea><div class="run-options"><select name="modelId"><option value="">Automatic model fallback</option>@foreach (var m in Model.State.Models.Where(x => x.IsEnabled)) { <option value="@m.Id">@m.Name</option> }</select><select name="requiredCapability"><option value="Orchestrator">Orchestrator</option>@foreach (var capability in AiCapabilities.All.Where(item => item != AiCapabilities.Orchestrator)) { <option value="@capability">@capability</option> }</select><select name="conversationId"><option value="">New conversation</option>@foreach (var c in Model.State.Conversations.Where(x => x.ProjectId == project.Id).OrderByDescending(x => x.UpdatedAt)) { <option value="@c.Id">Continue: @c.Title</option> }</select></div><button>Run agent →</button>
                </form>
            }
            @if (Model.IsAdmin) { <form asp-controller="Manage" asp-action="DeleteProject" method="post" class="delete-project" onsubmit="return confirm('Delete this project and all its data?')"><input type="hidden" name="id" value="@project.Id"/><button class="link-danger">Delete project</button></form> }
        </article>
    }
</section>

<section id="steps" class="panel tab-panel">
    <div class="section-title"><div><p class="eyebrow">SERVER-MANAGED WORKFLOW</p><h2>Execution plan</h2><p class="muted">AI proposes the plan; the server owns step order, attempts, retries, and outcomes. PLAN.md is restored from this record if it is deleted.</p></div><a class="button secondary" asp-controller="Export" asp-action="Plans">Export CSV</a></div>
    <div id="plan-steps-list" data-plan-steps-url="@Url.Action("PlanStepsPartial", "Home")">@await Html.PartialAsync("_PlanSteps", Model)</div>
</section>

<section id="files" class="panel tab-panel">
    <div class="section-title"><div><h2>Folders & files</h2><p class="muted">Upload, create folders, preview, edit, or safely remove project files.</p></div><a class="button secondary" asp-controller="Export" asp-action="Files">Export CSV</a></div>
    @if (!Model.VisibleProjects.Any()) { <div class="empty">No project workspaces are available yet.</div> }
    @if (Model.VisibleProjects.Any())
    {
        <div class="file-project-switcher">
            <select aria-label="Project" data-file-project-select>@foreach (var project in Model.VisibleProjects) { <option value="@project.Id" data-workspace-url="@Url.Action("WorkspacePartial", "Files", new { projectId = project.Id })">@project.Name</option> }</select>
        </div>
        <div class="dashboard-inline-workspace selected-project-workspace" data-selected-workspace></div>
    }
</section>

<section id="jobs" class="panel tab-panel">
    <div class="section-title"><div><p class="eyebrow">EXECUTION HISTORY</p><h2>Jobs</h2></div><a class="button secondary" asp-controller="Export" asp-action="Jobs">Export CSV</a></div>
    <div id="jobs-list" data-jobs-url="@Url.Action("JobsPartial", "Home")">@await Html.PartialAsync("_JobsList", Model)</div>
</section>

<section id="chats" class="panel tab-panel">
    <div class="section-title"><div><p class="eyebrow">REQUEST & RESPONSE HISTORY</p><h2>Chats</h2><p class="muted">Messages and request/response history update independently without refreshing the page.</p></div></div>
    <section class="live-history-panel" data-disclosure-scope>
        <header class="live-history-head"><div><h3>Warnings, errors, and system messages</h3><p>Newest first · scroll for older messages</p></div><div class="live-history-actions"><button type="button" class="secondary" data-disclosure-action="expand" data-disclosure-target=".message-item">Expand</button><button type="button" class="secondary" data-disclosure-action="collapse" data-disclosure-target=".message-item">Collapse</button><a class="button secondary" asp-controller="Export" asp-action="Messages">CSV</a>@if (Model.IsAdmin) { <form asp-controller="Manage" asp-action="ClearMessages" method="post" data-live-clear data-clear-target="messages-list" data-confirm="Clear all warnings, errors, and system messages?"><button class="link-danger">Clear</button></form> }</div></header>
        <div id="messages-list" data-live-list="messages" data-live-url="@Url.Action("MessagesPartial", "Home")">@await Html.PartialAsync("_MessagesList", Model)</div>
    </section>
    <section class="live-history-panel" data-disclosure-scope>
        <header class="live-history-head"><div><h3>Chats</h3><p>Newest first · scroll for older chats</p></div><div class="live-history-actions"><button type="button" class="secondary" data-disclosure-action="expand" data-disclosure-target=".chat-thread">Expand</button><button type="button" class="secondary" data-disclosure-action="collapse" data-disclosure-target=".chat-thread">Collapse</button><a class="button secondary" asp-controller="Export" asp-action="Chats">CSV</a>@if (Model.IsAdmin) { <form asp-controller="Manage" asp-action="ClearChats" method="post" data-live-clear data-clear-target="chats-list" data-confirm="Clear all saved chats?"><button class="link-danger">Clear</button></form> }</div></header>
        <div id="chats-list" data-live-list="chats" data-live-url="@Url.Action("ChatsPartial", "Home")">@await Html.PartialAsync("_ChatsList", Model)</div>
    </section>
</section>

@if (Model.IsAdmin)
{
<section id="tools" class="panel tab-panel">
    <div class="section-title runtime-audit-title"><div><p class="eyebrow">AI TOOL AUDIT</p><h2>Tools</h2><p class="muted">Open a row to see exactly which project tool ran and what it returned.</p></div><div class="export-actions"><a class="button secondary" asp-controller="Export" asp-action="Tools">Export CSV</a><form asp-controller="AgentRuntime" asp-action="ClearAudit" method="post" onsubmit="return confirm('Clear the tool activity history?')"><button class="link-danger">Clear activity</button></form></div></div>
    <div id="tool-audit-list" data-tool-audit-url="@Url.Action("ToolAuditPartial", "Home")">@await Html.PartialAsync("_ToolAuditList", Model)</div>
</section>

<section id="workspace" class="panel tab-panel">
    @await Html.PartialAsync("_ToolConfiguration", Model)
</section>

<section id="connections" class="panel tab-panel">
    <div class="section-title"><div><p class="eyebrow">SERVICES & MODEL ROUTING</p><h2>Connections</h2><p class="muted">Models are tried by capability and priority. If one fails, the same job continues with the next eligible connection.</p></div><a class="button secondary" asp-controller="Export" asp-action="Models">Export CSV</a></div>
    <details class="create-box connection-creator"><summary>＋ Add connection</summary>
        <form asp-controller="Manage" asp-action="CreateModel" method="post" class="form-grid" data-ai-connection-form>
            <label>Connection type<select name="providerId" data-ai-provider>@foreach (var provider in Model.State.AiProviderCatalog) { <option value="@provider.Id" data-base-url="@provider.BaseUrl">@provider.Name</option> }</select></label>
            <label>Display name<input name="name" required placeholder="My AI connection" /></label>
            <label>Model ID<input name="modelId" list="connection-model-list" required placeholder="Select or enter a model" /></label><datalist id="connection-model-list"></datalist>
            <label>Priority<input name="priority" type="number" min="1" max="999" value="100" /><small>Lower numbers are tried first.</small></label>
            <label class="wide">Base URL<input name="baseUrl" type="url" required value="@Model.State.AiProviderCatalog.FirstOrDefault()?.BaseUrl" /></label>
            <label class="wide">API key<input name="apiKey" type="password" autocomplete="off" placeholder="Optional for local models" /></label>
            <fieldset class="wide capability-picker"><legend>Active capabilities</legend>@foreach (var capability in AiCapabilities.All) { <label class="check"><input type="checkbox" name="capabilities" value="@capability" /> @capability</label> }</fieldset>
            <div class="wide provider-links" data-provider-links></div><label class="check"><input type="checkbox" name="isEnabled" value="true" checked /> Active</label><button>Add AI connection</button>
        </form>
    </details>
    <script type="application/json" id="ai-provider-catalog">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.State.AiProviderCatalog, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))</script>
    <form id="bulk-ai-connections" asp-controller="Manage" asp-action="BulkModels" method="post" class="connection-bulk-actions"><strong>@Model.State.Models.Count AI connection(s)</strong><button name="action" value="activate" class="secondary">Activate selected</button><button name="action" value="deactivate" class="secondary">Deactivate selected</button><button name="action" value="delete" class="danger" onclick="return confirm('Delete selected AI connections?')">Delete selected</button></form>
    <div class="connection-list">
    @foreach (var m in Model.State.Models.OrderBy(item => item.Priority).ThenBy(item => item.Name))
    {
        var provider = Model.State.AiProviderCatalog.FirstOrDefault(item => item.Id == m.ProviderId);
        <article class="connection-card @(m.IsEnabled ? "active" : "inactive")">
            <header><label class="connection-select"><input form="bulk-ai-connections" type="checkbox" name="selectedIds" value="@m.Id" aria-label="Select @m.Name" /></label><span class="status @(m.IsEnabled ? "online" : "")"></span><div><h3>@m.Name</h3><p>@(provider?.Name ?? m.ProviderId) · <code>@m.ModelId</code> · priority @m.Priority</p></div><span class="pill">@(m.IsEnabled ? "active" : "inactive")</span></header>
            <div class="capability-row" aria-label="Capabilities for @m.Name">
                @foreach (var capability in AiCapabilities.All)
                {
                    <label class="capability-chip"><input type="checkbox" checked="@(m.Capabilities.Contains(capability, StringComparer.OrdinalIgnoreCase))" data-model-capability data-model-id="@m.Id" value="@capability" /> @capability</label>
                }
            </div>
            @if (m.Capabilities.Count == 0) { <p class="capability-default">Using predefined capabilities: @string.Join(", ", m.SuggestedCapabilities.DefaultIfEmpty("Generator"))</p> }
            <div class="connection-meta"><span>@m.BaseUrl</span><span>Test: @m.LastTestStatus@(m.LastTestedAt is null ? "" : $" · {m.LastTestedAt.Value.ToLocalTime():g}")</span>@if (!string.IsNullOrWhiteSpace(m.LastTestMessage)) { <small>@m.LastTestMessage</small> }</div>
            <div class="actions"><form asp-controller="Manage" asp-action="TestModel" method="post"><input type="hidden" name="id" value="@m.Id"/><button class="secondary">Test request</button></form><form asp-controller="Manage" asp-action="ToggleModel" method="post"><input type="hidden" name="id" value="@m.Id"/><button class="secondary">@(m.IsEnabled ? "Deactivate" : "Activate")</button></form><details><summary>Edit</summary><form asp-controller="Manage" asp-action="UpdateModel" method="post" class="form-grid compact"><input type="hidden" name="id" value="@m.Id"/><input type="hidden" name="providerId" value="@m.ProviderId"/><label>Name<input name="name" value="@m.Name" required /></label><label>Model ID<input name="modelId" value="@m.ModelId" required /></label><label>Priority<input name="priority" type="number" min="1" max="999" value="@m.Priority" /></label><label>New API key<input name="apiKey" type="password" placeholder="Leave blank to keep current" /></label><label class="wide">Base URL<input name="baseUrl" type="url" value="@m.BaseUrl" required /></label><button>Save</button></form></details><form asp-controller="Manage" asp-action="DeleteModel" method="post" onsubmit="return confirm('Delete this AI connection?')"><input type="hidden" name="id" value="@m.Id"/><button class="link-danger">Delete</button></form></div>
        </article>
    }
    </div>
    <section class="connection-subsection"><div class="section-title"><div><p class="eyebrow">OBJECT STORAGE</p><h2>S3 / Spaces</h2><p class="muted">@(ObjectStorage.IsEnabled ? "Connected. Project files restore at startup and synchronize in the background." : "Not configured. Add S3 or Spaces application variables to enable managed file storage.")</p></div><span class="pill">@(ObjectStorage.IsEnabled ? "active" : "local fallback")</span></div><div class="connection-help"><code>S3_BUCKET</code><code>S3_ENDPOINT</code><code>S3_ACCESS_KEY</code><code>S3_SECRET_KEY</code><a href="https://docs.digitalocean.com/products/spaces/how-to/manage-access/" target="_blank" rel="noopener">Spaces keys ↗</a><a href="https://docs.aws.amazon.com/AmazonS3/latest/userguide/GetStartedWithS3.html" target="_blank" rel="noopener">S3 documentation ↗</a></div></section>
    <div class="connection-subsection">
    <div class="section-title"><div><p class="eyebrow">SOURCE CONTROL & AUTOMATION</p><h2>GitHub connections</h2></div><a class="button secondary" asp-controller="Export" asp-action="GitHub">Export CSV</a></div>
    <details class="create-box"><summary>＋ Connect with fine-grained token</summary>
        <form asp-controller="GitHub" asp-action="ConnectToken" method="post" class="form-grid compact">
            <input type="hidden" name="returnUrl" value="/#connections" />
            <label class="wide">Fine-grained access token<input name="token" type="password" required autocomplete="off" spellcheck="false" placeholder="github_pat_…" /></label>
            <p class="wide form-help"><a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">Create a fine-grained token on GitHub ↗</a>. Repository access and capabilities are limited to what you select there. The token is encrypted at rest.</p>
            <button>Connect GitHub</button>
        </form>
    </details>
    @if (GitHub.IsConfigured) { <details class="configuration-note"><summary>Advanced GitHub App connection</summary><a class="button secondary" asp-controller="GitHub" asp-action="Connect" asp-route-returnUrl="/#connections">Connect configured GitHub App</a></details> }
    @if (!Model.State.GitHubConnections.Any())
    {
        <div class="empty">No GitHub accounts are connected yet.</div>
    }
    @foreach (var connection in Model.State.GitHubConnections)
    {
        <article class="github-card">
            <div class="project-head"><div><h3>@connection.AccountLogin</h3><p>@connection.AuthenticationType authentication · @connection.AccountType · @connection.Repositories.Count repositories · refreshed @connection.RefreshedAt.ToLocalTime().ToString("g")</p></div>
                <div class="actions">@if (!string.IsNullOrWhiteSpace(connection.SettingsUrl)) { <a class="button secondary" href="@connection.SettingsUrl">Manage on GitHub</a> }<form asp-controller="GitHub" asp-action="Refresh" method="post"><input type="hidden" name="id" value="@connection.Id"/><button class="secondary">Refresh</button></form><form asp-controller="GitHub" asp-action="Delete" method="post" onsubmit="return confirm('Remove this GitHub connection from the server?')"><input type="hidden" name="id" value="@connection.Id"/><button class="link-danger">Remove</button></form></div>
            </div>
            @foreach (var project in Model.State.Projects)
            {
                var selected = Model.State.ProjectRepositories.Where(x => x.ProjectId == project.Id && x.GitHubConnectionId == connection.Id).Select(x => x.RepositoryId).ToHashSet();
                <form asp-controller="GitHub" asp-action="SetProjectRepositories" method="post" class="repository-map">
                    <input type="hidden" name="projectId" value="@project.Id"/><input type="hidden" name="connectionId" value="@connection.Id"/>
                    <strong>@project.Name</strong>
                    <div class="repository-options">
                        @foreach (var repository in connection.Repositories)
                        {
                            <label class="check"><input type="checkbox" name="repositoryIds" value="@repository.Id" checked="@(selected.Contains(repository.Id))"/> @repository.FullName <small>@(repository.IsPrivate ? "private" : "public")</small></label>
                        }
                    </div>
                    <button class="secondary">Save repositories</button>
                </form>
                @foreach (var repository in connection.Repositories.Where(x => selected.Contains(x.Id))) { <form asp-controller="GitHub" asp-action="ImportRepository" method="post" class="import-repository"><input type="hidden" name="projectId" value="@project.Id"/><input type="hidden" name="repositoryId" value="@repository.Id"/><button class="secondary">Import fresh copy of @repository.FullName</button></form> }
            }
        </article>
    }
    @foreach (var project in Model.State.Projects)
    {
        var mapped = Model.State.ProjectRepositories.Where(x => x.ProjectId == project.Id).Select(x => x.RepositoryId).ToHashSet();
        var choices = Model.State.GitHubConnections.SelectMany(x => x.Repositories).Where(x => mapped.Contains(x.Id)).ToList();
        <form asp-controller="GitHub" asp-action="SetResultsRepository" method="post" class="create-box form-grid"><input type="hidden" name="projectId" value="@project.Id"/><label>@project.Name result destination<select name="repositoryId"><option value="">Local project results folder</option>@foreach (var repository in choices) { <option value="@repository.Id" selected="@(project.ResultsRepositoryId == repository.Id)">@repository.FullName</option> }</select></label><button>Save destination</button></form>
    }
    </div>
</section>

<section id="access" class="panel tab-panel">
    <div class="section-title"><div><p class="eyebrow">USERS & PERMISSIONS</p><h2>Access control</h2></div><a class="button secondary" asp-controller="Export" asp-action="Access">Export CSV</a></div>
    <form asp-controller="Manage" asp-action="CreateUser" method="post" class="form-grid create-box open"><label>Username<input name="username" required /></label><label>Password<input name="password" type="password" minlength="10" required /></label><label>Role<select name="role"><option value="Member">Member</option><option value="Admin">Admin</option></select></label><button>Create user</button></form>
    @foreach (var user in Model.State.Users)
    {
        <article class="user-card"><div class="user-head"><div><strong>@user.Username</strong><span class="pill">@user.Role · @(user.IsEnabled ? "enabled" : "disabled")</span></div>@if (user.Id != Model.CurrentUserId) { <form asp-controller="Manage" asp-action="ToggleUser" method="post"><input type="hidden" name="id" value="@user.Id"/><button class="secondary">@(user.IsEnabled ? "Disable" : "Enable")</button></form> }</div>
        @if (user.Role != Roles.Admin) { <div class="permissions">@foreach (var project in Model.State.Projects) { var permission = Model.State.Permissions.FirstOrDefault(x => x.UserId == user.Id && x.ProjectId == project.Id); <form asp-controller="Manage" asp-action="SetPermission" method="post"><input type="hidden" name="userId" value="@user.Id"/><input type="hidden" name="projectId" value="@project.Id"/><strong>@project.Name</strong><label class="check"><input type="checkbox" name="canView" value="true" checked="@(permission?.CanView == true)"/> View</label><label class="check"><input type="checkbox" name="canManage" value="true" checked="@(permission?.CanManage == true)"/> Manage</label><label class="check"><input type="checkbox" name="canRun" value="true" checked="@(permission?.CanRun == true)"/> Run</label><button class="secondary">Save</button></form> }</div> }
        </article>
    }
</section>
}
