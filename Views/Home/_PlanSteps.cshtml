@model DashboardViewModel
@{
    bool CanManage(Guid projectId) => Model.IsAdmin || Model.State.Permissions.Any(x => x.UserId == Model.CurrentUserId && x.ProjectId == projectId && x.CanManage);
    var plans = Model.State.ExecutionPlans.Where(plan => Model.VisibleProjects.Any(project => project.Id == plan.ProjectId)).OrderBy(plan => Model.VisibleProjects.First(project => project.Id == plan.ProjectId).Name).ToList();
    var version = string.Join('|', plans.SelectMany(plan => plan.Steps).OrderBy(step => step.Order).Select(step => $"{step.Id}:{step.Order}:{step.Title}:{step.IsActive}:{step.Status}:{step.RetryLimit}:{step.Attempts.Count}:{step.Attempts.LastOrDefault()?.Status}"));
}
<div data-plan-steps-version="@version">
@if (plans.Count == 0)
{
    <div class="empty">No server-managed steps yet. The next loop job will generate and store its fixed steps here without creating a planning file.</div>
}
@foreach (var plan in plans)
{
    var project = Model.VisibleProjects.First(item => item.Id == plan.ProjectId);
    var loop = plan.LoopId is Guid loopId ? Model.State.Loops.FirstOrDefault(item => item.Id == loopId) : null;
    var finishedCount = plan.Steps.Count(step => step.Status is PlanStepStatuses.Succeeded or PlanStepStatuses.Skipped);
    <details class="plan-board" data-plan-id="@plan.Id">
        <summary class="plan-board-head">
            <div><h3>@project.Name · @(loop?.Name ?? "Manual workflow")</h3><p>@finishedCount of @plan.Steps.Count fixed steps finished · updated @plan.UpdatedAt.ToLocalTime().ToString("g")</p></div>
            <span class="pill">Fixed at loop start</span>
        </summary>
        @{ var orderedSteps = plan.Steps.OrderBy(item => item.Order).ToList(); }
        <div class="plan-step-list" data-project-id="@project.Id">
        @for (var stepIndex = 0; stepIndex < orderedSteps.Count; stepIndex++)
        {
            var step = orderedSteps[stepIndex];
            <details class="plan-step @step.Status.ToLowerInvariant() @(!step.IsActive ? "inactive" : "") @(CanManage(project.Id) ? "manageable" : "")" data-step-id="@step.Id" open="@(step.Status is PlanStepStatuses.Running or PlanStepStatuses.Retrying or PlanStepStatuses.Failed)">
                <summary>
                    <span class="plan-step-number">@step.Order</span>
                    <span class="plan-step-copy"><strong>@step.Title</strong><small>@step.Attempts.Count attempt@(step.Attempts.Count == 1 ? "" : "s") · retry limit @(step.RetryLimit?.ToString() ?? "unlimited")</small></span>
                    <span class="plan-step-badges">@if (!step.IsActive) { <span class="badge inactive">Inactive</span> }<span class="badge @step.Status.ToLowerInvariant()">@step.Status</span></span>
                </summary>
                <div class="plan-step-body">
                    @if (CanManage(project.Id))
                    {
                        <div class="plan-step-actions">
                            <form asp-controller="Manage" asp-action="SetPlanStepRetryLimit" method="post"><input type="hidden" name="projectId" value="@project.Id"/><input type="hidden" name="stepId" value="@step.Id"/><label>Retry limit<input type="number" name="retryLimit" min="1" value="@step.RetryLimit" placeholder="Unlimited"/></label><button class="secondary">Save</button></form>
                            @if (step.Status is PlanStepStatuses.Failed or PlanStepStatuses.Skipped) { <form asp-controller="Manage" asp-action="RetryPlanStep" method="post"><input type="hidden" name="projectId" value="@project.Id"/><input type="hidden" name="stepId" value="@step.Id"/><button class="secondary">Retry step</button></form> }
                            @if (step.Status is not PlanStepStatuses.Succeeded and not PlanStepStatuses.Skipped) { <form asp-controller="Manage" asp-action="SkipPlanStep" method="post" onsubmit="return confirm('Skip this plan step?')"><input type="hidden" name="projectId" value="@project.Id"/><input type="hidden" name="stepId" value="@step.Id"/><button class="link-danger">Skip</button></form> }
                        </div>
                    }
                    @if (step.Attempts.Count == 0) { <p class="muted">Waiting for its first execution.</p> }
                    @foreach (var attempt in step.Attempts.OrderByDescending(item => item.Number))
                    {
                        <div class="step-attempt">
                            <div><strong>Attempt @attempt.Number</strong><span class="badge @attempt.Status.ToLowerInvariant()">@attempt.Status</span><time>@attempt.StartedAt.ToLocalTime().ToString("g")</time></div>
                            @if (!string.IsNullOrWhiteSpace(attempt.Summary)) { <p>@attempt.Summary</p> }
                            @if (!string.IsNullOrWhiteSpace(attempt.Error)) { <p class="error-text">@attempt.Error</p> }
                            @if (attempt.ChangedPaths.Count > 0) { <p class="changed-paths">@string.Join(" · ", attempt.ChangedPaths)</p> }
                            @if (!string.IsNullOrWhiteSpace(attempt.CommitUrl)) { <a href="@attempt.CommitUrl" target="_blank" rel="noopener">Open published project commit ↗</a> }
                        </div>
                    }
                </div>
            </details>
        }
        </div>
        <p class="muted">This step list is locked. Create a new loop when you want a new plan or additional steps.</p>
    </details>
}
</div>
