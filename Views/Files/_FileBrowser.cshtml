@model FileManagerViewModel
@{
    var parent = string.IsNullOrEmpty(Model.Path) ? "" : string.Join('/', Model.Path.Split('/').SkipLast(1));
    var folderCount = Model.Entries.Count(item => item.IsDirectory);
    var fileCount = Model.Entries.Count - folderCount;
    var totalSize = Model.Entries.Sum(item => item.Size);
    var pathParts = Model.Path.Split('/', StringSplitOptions.RemoveEmptyEntries);
    var breadcrumbPath = "";
}
<div class="file-commandbar" data-file-manager data-current-path="@Model.Path">
    <details class="file-actions-panel">
        <summary>＋ Upload files or create folder</summary>
        <div class="file-toolbar">
            <form asp-action="Upload" method="post" enctype="multipart/form-data" data-file-ajax-form><input type="hidden" name="projectId" value="@Model.Project.Id"/><input type="hidden" name="path" value="@Model.Path"/><label>Upload files<input type="file" name="files" multiple required /></label><button>Upload</button></form>
            <form asp-action="CreateFolder" method="post" data-file-ajax-form><input type="hidden" name="projectId" value="@Model.Project.Id"/><input type="hidden" name="path" value="@Model.Path"/><label>New folder<input name="name" required maxlength="100" /></label><button class="secondary">Create folder</button></form>
        </div>
    </details>
    <div class="explorer-topbar">
        <div class="explorer-navigation">
            @if (!string.IsNullOrEmpty(Model.Path)) { <a class="button secondary parent-folder-button file-drop-target" data-file-nav="true" data-drop-path="@parent" asp-action="Index" asp-route-projectId="@Model.Project.Id" asp-route-path="@parent">← Parent folder</a> }
            else { <span class="button secondary parent-folder-button disabled" aria-disabled="true">← Parent folder</span> }
            <nav class="folder-breadcrumbs" aria-label="Current folder path">
                <a data-file-nav="true" data-drop-path="" class="file-drop-target" asp-action="Index" asp-route-projectId="@Model.Project.Id" asp-route-path="">Root</a>
                @for (var index = 0; index < pathParts.Length; index++)
                {
                    breadcrumbPath = string.IsNullOrEmpty(breadcrumbPath) ? pathParts[index] : $"{breadcrumbPath}/{pathParts[index]}";
                    <span aria-hidden="true">›</span>
                    @if (index < pathParts.Length - 1)
                    {
                        <a data-file-nav="true" data-drop-path="@breadcrumbPath" class="file-drop-target" asp-action="Index" asp-route-projectId="@Model.Project.Id" asp-route-path="@breadcrumbPath">@pathParts[index]</a>
                    }
                    else
                    {
                        <strong aria-current="page">@pathParts[index]</strong>
                    }
                }
            </nav>
        </div>
        <div class="explorer-tools"><details class="file-search-panel"><summary>⌕ Search files</summary><label class="file-search"><span>Search</span><input type="search" placeholder="Search this folder…" data-file-search /></label></details><button type="button" class="secondary view-toggle" data-file-view-toggle aria-label="Switch to list view">☷ List view</button></div>
    </div>
    <form asp-action="MoveSelected" method="post" data-file-ajax-form data-move-files-form hidden><input type="hidden" name="projectId" value="@Model.Project.Id"/><input type="hidden" name="path" value="@Model.Path"/><input type="hidden" name="destinationPath" value="" data-move-destination/></form>
    <div class="file-selection-toolbar"><span><strong>@folderCount</strong> folders · <strong>@fileCount</strong> files · <strong>@FormatSize(totalSize)</strong></span><button type="button" class="secondary" data-select-files="all">Select all</button><button type="button" class="secondary" data-select-files="none">Deselect</button><form asp-action="DownloadSelected" method="post" data-download-selected-form><input type="hidden" name="projectId" value="@Model.Project.Id"/><input type="hidden" name="path" value="@Model.Path"/><button class="secondary" data-selection-action disabled>Download selected (<span data-selected-count>0</span>)</button></form>@if (Model.CanPublishToGitHub) { <form asp-action="PublishSelected" method="post" data-file-ajax-form data-selected-files-form><input type="hidden" name="projectId" value="@Model.Project.Id"/><input type="hidden" name="path" value="@Model.Path"/><button class="secondary" data-selection-action disabled>Publish selected (<span data-selected-count>0</span>)</button></form> }<form id="bulk-delete-form-@Model.Project.Id" asp-action="DeleteSelected" method="post" data-file-ajax-form data-selected-files-form data-confirm="Move the selected files and folders to project trash?"><input type="hidden" name="projectId" value="@Model.Project.Id"/><input type="hidden" name="path" value="@Model.Path"/><button class="danger" data-selection-action disabled>Delete selected (<span data-selected-count>0</span>)</button></form></div>
    <div class="explorer-list" data-file-browser data-view="grid">
        <div class="explorer-heading"><span></span><span>Name</span><span>Type / contents</span><span>Size</span><span>Modified</span></div>
        @foreach (var item in Model.Entries)
        {
            <article class="explorer-item @(item.IsDirectory ? "file-drop-target" : "")" data-file-item data-file-path="@item.RelativePath" data-file-name="@item.Name.ToLowerInvariant()" data-file-kind="@item.Kind" data-file-open-url="@Url.Action(item.IsDirectory ? "Index" : "Preview", new { projectId = Model.Project.Id, path = item.RelativePath })" data-file-directory="@item.IsDirectory.ToString().ToLowerInvariant()" @if (item.IsDirectory) { <text>data-drop-path="@item.RelativePath"</text> } draggable="true" tabindex="0"><label class="file-select" title="Select @item.Name"><input type="checkbox" name="selectedPaths" value="@item.RelativePath" form="bulk-delete-form-@Model.Project.Id" data-file-checkbox/><span></span></label><a class="explorer-main" data-file-nav="@(item.IsDirectory ? "true" : "preview")" asp-action="@(item.IsDirectory ? "Index" : "Preview")" asp-route-projectId="@Model.Project.Id" asp-route-path="@item.RelativePath">@if (item.Kind == "image") { <img src="@Url.Action("Preview", new { projectId = Model.Project.Id, path = item.RelativePath })" alt="" loading="lazy"/> } else if (!item.IsDirectory && !string.IsNullOrWhiteSpace(item.Preview)) { <pre>@item.Preview</pre> } else { <span class="file-icon">@(item.IsDirectory ? "📁" : item.Kind == "zip" ? "ZIP" : item.Kind.ToUpperInvariant())</span> }<strong>@item.Name</strong></a><span class="explorer-type">@(item.IsDirectory ? $"Folder · {item.FileCount} files · {item.DirectoryCount} folders" : item.Kind.ToUpperInvariant())</span><span class="explorer-size">@FormatSize(item.Size)</span><time class="explorer-modified">@item.ModifiedAt.ToLocalTime().ToString("g")</time></article>
        }
        @if (!Model.Entries.Any()) { <div class="empty">This folder is empty.</div> }
        <div class="empty file-search-empty" data-search-empty hidden>No matching files or folders.</div>
    </div>
</div>
@functions { string FormatSize(long bytes) => bytes >= 1_073_741_824 ? $"{bytes / 1_073_741_824d:0.##} GB" : bytes >= 1_048_576 ? $"{bytes / 1_048_576d:0.##} MB" : bytes >= 1024 ? $"{bytes / 1024d:0.##} KB" : $"{bytes} B"; }
