@{
    var projectCount = ViewBag.DashboardProjectCount is int projects ? projects : 0;
    var liveLoopCount = ViewBag.DashboardLiveLoopCount is int loops ? loops : 0;
    var isAdmin = ViewBag.DashboardIsAdmin is true;
    string DashboardTab(string fragment) => $"{Url.Action("Index", "Home")}#{fragment}";
}
<section class="hero dashboard-shell-hero">
    <div><p class="eyebrow">ORCHESTRATION CONTROL PLANE</p><h1>Loops that keep moving.</h1><p>Manage prompts, recurring work, remote models and access from one local dashboard.</p></div>
    <div class="metrics"><div><strong>@projectCount</strong><span>projects</span></div><div><strong>@liveLoopCount</strong><span>live loops</span></div></div>
</section>
<nav class="tabs dashboard-page-tabs">
    <a class="tab" href="@DashboardTab("projects")">Projects</a><a class="tab" href="@DashboardTab("steps")">Execution plan</a><a class="tab active" href="@DashboardTab("files")">Folders & files</a><a class="tab" href="@DashboardTab("jobs")">Jobs</a><a class="tab" href="@DashboardTab("chats")">Chats</a>
    @if (isAdmin) { <a class="tab" href="@DashboardTab("tools")">Tools</a><a class="tab advanced-tab" href="@DashboardTab("workspace")">AI workspace access <small>Advanced</small></a><a class="tab" href="@DashboardTab("connections")">Connections</a><a class="tab" href="@DashboardTab("access")">Access</a> }
</nav>
